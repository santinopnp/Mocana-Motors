# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mocana:mocana_dev@localhost:5432/mocana_motors

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_very_long_secret
JWT_EXPIRES_IN=7d

# ── Claude AI (Asistente Moto) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
MOTO_AI_MODEL=claude-sonnet-4-6
MOTO_AI_MAX_TOKENS=1024

# ── Zoho OAuth ───────────────────────────────────────────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_BOOKS_ORG_ID=
ZOHO_DESK_ORG_ID=
ZOHO_CAMPAIGNS_LIST_KEY=

# ── Payments ─────────────────────────────────────────────────────────────────
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Wompi (Colombia)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# ── Email (Nodemailer) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mocanamotors.com
EMAIL_FROM_NAME=Mocana Motors

# ── AWS S3 / Object Storage ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=mocana-motors-media

# ── Slack (alertas ops) ──────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
SLACK_OPS_CHANNEL=#mocana-ops

# ── MCP Server ───────────────────────────────────────────────────────────────
MOCANA_API_URL=http://localhost:3000/api
MOCANA_ADMIN_TOKEN=
